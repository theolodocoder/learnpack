        {
          "id": "mt-q-minor-third-above-a",
          "type": "quiz",
          "question": "The music director asks for a minor third above A for the alto line. Which note do you play?",
          "options": [
            "B",
            "C#",
            "C",
            "D"
          ],
          "answer": 2,
          "explanation": "A minor third is 3 half steps: A#, B, C. So the note is C. C# would be 4 half steps, a major third."
        },
        {
          "id": "mt-q-interval-flip",
          "type": "quiz",
          "question": "You know C up to F is a perfect fourth (5 half steps). What is F up to the next C?",
          "options": [
            "A perfect fifth, 7 half steps",
            "A perfect fourth, 5 half steps",
            "A major sixth, 9 half steps",
            "An octave, 12 half steps"
          ],
          "answer": 0,
          "explanation": "An interval and its flip add up to 12 half steps. 12 - 5 = 7, and 7 half steps is a perfect fifth: F#, G, G#, A, A#, B, C."
        }
      ]
