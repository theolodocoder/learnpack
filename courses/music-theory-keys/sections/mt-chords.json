        {
          "id": "mt-q-diminished",
          "type": "quiz",
          "question": "Which triad is diminished?",
          "options": [
            "A C E",
            "G B D",
            "B D F",
            "F A C"
          ],
          "answer": 2,
          "explanation": "Measure the gaps. B to D is 3 half steps and D to F is 3: a diminished triad, with a tritone (6) from B to F. A C E is 3 + 4 (minor); G B D and F A C are 4 + 3 (major)."
        },
        {
          "id": "mt-q-minor-triad",
          "type": "quiz",
          "question": "You're playing E major (E G# B) and the leader says \"make it minor\". What do you change?",
          "options": [
            "Lower G# to G",
            "Lower B to Bb",
            "Raise E to F",
            "Lower all three notes by a half step"
          ],
          "answer": 0,
          "explanation": "Major and minor share the root and fifth. Only the third moves: lower it one half step, G# to G, giving E G B (3 + 4)."
        }
      ]
