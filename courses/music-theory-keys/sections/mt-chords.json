          "id": "mt-q-voice-leading",
          "type": "quiz",
          "question": "You're playing C E G and the next chord is F major. Which F major voicing moves your right hand least?",
          "options": [
            "F A C",
            "A C F",
            "C F A",
            "F C A"
          ],
          "answer": 2,
          "explanation": "C F A (second inversion) keeps C where it is and moves E up a half step to F and G up a whole step to A. F A C jumps every finger."
        }
