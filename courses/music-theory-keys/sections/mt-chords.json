          "id": "mt-q-interval",
          "type": "quiz",
          "question": "How many half steps is it from C up to G, and what is the interval called?",
          "options": [
            "5, a perfect fourth",
            "7, a perfect fifth",
            "6, a tritone",
            "8, a minor sixth"
          ],
          "answer": 1,
          "explanation": "Count from C without counting C itself: C#, D, D#, E, F, F#, G is 7 half steps. 7 half steps is a perfect fifth."
        },
