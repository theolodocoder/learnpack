        {
          "id": "mt-q-dominant",
          "type": "quiz",
          "question": "A chart says A7. What do you play?",
          "options": [
            "A C# E G#",
            "A C# E G",
            "A C E G",
            "A D E G"
          ],
          "answer": 1,
          "explanation": "\"7\" on its own means dominant 7: a major triad plus a minor 7th, gaps 4 3 3. A up 4 is C#, up 3 is E, up 3 is G. A C# E G# is Amaj7; A C E G is Am7."
        },
        {
          "id": "mt-q-sus",
          "type": "quiz",
          "question": "Which notes make Dsus4?",
          "options": [
            "D F# A",
            "D E A",
            "D G A",
            "D F A"
          ],
          "answer": 2,
          "explanation": "Sus4 replaces the third with the perfect 4th: root, 4th, 5th (gaps 5 2). D up 5 is G, G up 2 is A. D E A is Dsus2."
        },
        {
          "id": "mt-q-minor-seven",
          "type": "quiz",
          "question": "In C major, the chord built on the 2nd degree with four notes is D F A C. What is it?",
          "options": [
            "Dmaj7",
            "D7",
            "Dm7",
            "Dm7b5"
          ],
          "answer": 2,
          "explanation": "Measure the gaps: D to F is 3, F to A is 4, A to C is 3. 3 4 3 is minor 7, so it's Dm7. This is the 2 in the 2-5-1 Dm7 G7 Cmaj7."
        }
      ]
